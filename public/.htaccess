# =============================================================================
#  damiansinczak.dev - static site on OVH shared hosting (Apache)
#  Deployed by uploading the contents of dist/ into the hosting www/ folder.
# =============================================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# -----------------------------------------------------------------------------
# Canonical host and scheme
#
# Rule 1 catches plain HTTP and jumps straight to https://www, so an
# http://damiansinczak.dev request resolves in a single 301 rather than
# chaining through https://damiansinczak.dev first.
#
# OVH terminates TLS in front of Apache, so %{HTTPS} alone is not reliable;
# X-Forwarded-Proto is the header that actually reflects the client scheme.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.damiansinczak.dev%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} !^www\.damiansinczak\.dev$ [NC]
  RewriteRule ^ https://www.damiansinczak.dev%{REQUEST_URI} [R=301,L]

  # Directory requests with no index file: answer 404, not 403.
  #
  # `Options -Indexes` above makes Apache reject a bare directory request with
  # 403 Forbidden. That is technically true but semantically wrong — /assets/
  # is not forbidden, it simply has no page — and Googlebot tries parent paths
  # by truncating URLs it has already seen. Left alone, /assets/ and /_astro/
  # show up in Search Console as "Blocked due to access forbidden (403)", which
  # reads like a misconfigured server rather than an empty directory.
  #
  # 404 is the honest answer and Search Console treats it as unremarkable.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

# -----------------------------------------------------------------------------
# MIME types
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/pdf              .pdf
  AddType image/svg+xml                .svg
  AddType image/jpeg                   .jpg .jpeg
  AddType image/png                    .png
  AddType image/x-icon                 .ico
  AddType text/css                     .css
  AddType application/javascript       .js
  AddType application/xml              .xml
  AddType application/manifest+json    .webmanifest

  # robots.txt, llms.txt, llms-full.txt and security.txt. Without an explicit
  # charset the Polish diacritics in llms-full.txt arrive as mojibake for any
  # client that trusts the header over the bytes.
  AddType text/plain                   .txt
  AddCharset UTF-8                     .txt .xml .css .svg
</IfModule>

# -----------------------------------------------------------------------------
# Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

# -----------------------------------------------------------------------------
# Caching
#
# Files under /_astro/ carry a content hash in the filename, so a changed file
# gets a changed URL and can be cached forever. Everything else keeps a stable
# filename across deploys and must revalidate, otherwise a new CV or a new
# profile photo would sit invisible in browser caches.
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|webp|ico)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # robots.txt, sitemap.xml, llms*.txt and security.txt are the crawler-facing
  # surface. They must revalidate, or a fixed robots policy sits stale in an
  # intermediary cache for as long as it feels like.
  <FilesMatch "\.(txt|xml|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# Security headers
#
# The page ships no JavaScript at all, so script-src can be 'none'.
# 'unsafe-inline' is needed only for style-src because two elements carry an
# inline style attribute (image object-position).
#
# manifest-src is spelled out because default-src 'none' does not grant it:
# without this line the browser blocks /site.webmanifest outright.
#
# The JSON-LD block is <script type="application/ld+json">. CSP does not apply
# to it — it carries data, not executable code — so script-src stays 'none'.
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"


  # HSTS. Deliberately without includeSubDomains: the apex and www hold separate
  # Let's Encrypt certificates renewed independently, and other subdomains are
  # not covered at all. Start at one day; raise to 31536000 once a renewal cycle
  # has passed without incident.
  Header always set Strict-Transport-Security "max-age=86400" env=HTTPS
</IfModule>

# -----------------------------------------------------------------------------
# Keep source and tooling files unreachable if they ever land on the server
#
# FilesMatch tests the basename only, so `/.well-known/security.txt` is matched
# as "security.txt" and stays reachable despite the leading-dot rule. The rule
# blocks .json, which is why the web app manifest uses the .webmanifest
# extension rather than manifest.json.
# -----------------------------------------------------------------------------
<FilesMatch "(^\.|\.(md|ts|json|lock|yml|yaml)$)">
  Require all denied
</FilesMatch>

<Files ".htaccess">
  Require all denied
</Files>
