---
// Light / Dark / System buttons. public/site.js wires up every [data-theme-option]
// on the page, so this can appear in more than one menu.
---

<button type="button" class="theme-option" data-theme-option="light"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2.5v2M12 19.5v2M21.5 12h-2M4.5 12h-2M18.72 5.28l-1.42 1.42M6.7 17.3l-1.42 1.42M18.72 18.72 17.3 17.3M6.7 6.7 5.28 5.28"></path></svg><span>Light</span></button>
<button type="button" class="theme-option" data-theme-option="dark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5 8.5 8.5 0 1 0 20.5 14.6Z"></path></svg><span>Dark</span></button>
<button type="button" class="theme-option" data-theme-option="system"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="theme-icon__half" d="M12 3.5a8.5 8.5 0 0 0 0 17Z"></path><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17"></path></svg><span>System</span></button>
