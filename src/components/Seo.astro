---
import type { Profile } from "../core/model/profile";
import { buildJsonLd } from "../core/seo/jsonLd";
import { buildSeoMeta, type PageMeta } from "../core/seo/meta";
import { absoluteUrl, siteConfig } from "../core/site/config";
import BaseHead from "./BaseHead.astro";

/**
 * Head for the profile page: BaseHead plus the profile-only extras.
 *
 * All values are derived from content/profile.md via `buildSeoMeta`, so the
 * page description, share card text and structured data cannot drift away from
 * the CV itself. Overrides live in the `seo:` frontmatter block, not here.
 */

type Props = {
  profile: Profile;
  /** ISO date (YYYY-MM-DD) of the last content change, from git. */
  dateModified: string;
};

const { profile, dateModified } = Astro.props;

const seo = buildSeoMeta(profile);
const jsonLd = buildJsonLd(profile, seo, dateModified);

const meta: PageMeta = {
  pageTitle: seo.pageTitle,
  description: seo.description,
  ogType: "profile",
  ogImageAlt: `${profile.name} — ${seo.jobTitle ?? profile.title}`
};

const [firstName, ...rest] = profile.name.split(" ");
const lastName = rest.join(" ");
---

<BaseHead meta={meta}>
  {firstName && <meta property="profile:first_name" content={firstName} />}
  {lastName && <meta property="profile:last_name" content={lastName} />}

  {/*
    Machine-readable mirrors. `alternate type="text/markdown"` is how an agent that
    has fetched the HTML discovers there is a cleaner version of the same content.
  */}
  <link rel="alternate" type="text/markdown" href={absoluteUrl(siteConfig.llms.full)} title={`${profile.name} — profile as Markdown`} />
  <link rel="alternate" type="application/pdf" href={absoluteUrl(`/${profile.pdf.filename}`)} title={`${profile.name} — CV (PDF)`} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseHead>
