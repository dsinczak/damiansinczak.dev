---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getPublishedBlogPosts } from "../../core/blog/posts";
import { buildBlogIndexJsonLd } from "../../core/seo/jsonLd";
import { buildBlogIndexMeta } from "../../core/seo/meta";
import { siteConfig } from "../../core/site/config";

const meta = buildBlogIndexMeta(siteConfig.name);
const jsonLd = buildBlogIndexJsonLd(meta, getPublishedBlogPosts());
---

<BlogLayout meta={meta} jsonLd={jsonLd}>
  <article class="blog-welcome">
    <h1>Welcome</h1>
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non massa at arcu tincidunt posuere. Donec in est vel lectus vehicula luctus.</p>
    <p>Integer euismod, justo at aliquet viverra, libero massa tincidunt urna, at hendrerit orci mauris a erat. New articles will be listed on the left.</p>
  </article>
</BlogLayout>
