---
import { prepareProfileAssets } from "../core/assets/prepareAssets";
import { filterProfileForTarget } from "../core/filtering/filterProfileForTarget";
import type { ProfileEntry, ProfileSection, RichTextBlock } from "../core/model/profile";
import { parseProfileFile } from "../core/parser/parseProfile";
import { renderMarkdown } from "../core/rendering/markdown";
import { validateProfile } from "../core/validation/validateProfile";
import githubMarkUrl from "../assets/web/github-mark.svg";
import linkedinMarkUrl from "../assets/web/linkedin-mark.svg";
import "../styles/global.css";

const parsed = parseProfileFile("content/profile.md");
if (!parsed.profile || parsed.errors.length > 0) {
  throw new Error(parsed.errors.map((message) => message.message).join("\n"));
}

const validationErrors = validateProfile(parsed.profile).filter((message) => message.severity === "error");
if (validationErrors.length > 0) {
  throw new Error(validationErrors.map((message) => message.message).join("\n"));
}

const profile = prepareProfileAssets(filterProfileForTarget(parsed.profile, "web"));
const contactAvailable = Boolean(profile.email || profile.phone || profile.links.linkedin || profile.links.github);
const navSections = profile.sections.filter((section) => section.blocks.length > 0 || section.entries.length > 0);
const pdfHref = `/${profile.pdf.filename}`;

function sectionHref(section: ProfileSection) {
  return `#${section.id}`;
}

function renderBlocks(blocks: RichTextBlock[]) {
  return blocks.map((block) => {
    const html = renderMarkdown(block.markdown);
    if (block.kind === "detail" || block.metadata.web === "collapsed" || block.metadata.web === "expanded") {
      return {
        kind: "detail",
        html,
        open: block.metadata.web === "expanded",
        label: block.label
      };
    }
    return { kind: "html", html, open: false };
  });
}

function primaryRole(entry: ProfileEntry) {
  return entry.fields.Role || entry.fields.Degree || entry.fields.Category || entry.fields.Language;
}

const navIcons: Record<string, string> = {
  bio: '<circle cx="12" cy="8" r="3.25"></circle><path d="M5.5 20a6.5 6.5 0 0 1 13 0"></path>',
  experience: '<path d="M9 7V5.75A1.75 1.75 0 0 1 10.75 4h2.5A1.75 1.75 0 0 1 15 5.75V7"></path><rect x="4" y="7" width="16" height="12" rx="2"></rect><path d="M4 12h16"></path><path d="M10 12v1.5h4V12"></path>',
  projects: '<path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H10l2 2h5.5A2.5 2.5 0 0 1 20 9.5V17a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"></path>',
  skills: '<path d="M12 3.75 14.8 9l5.7.85-4.1 4.05.95 5.7L12 16.9 6.65 19.6l.95-5.7-4.1-4.05L9.2 9Z"></path>',
  publications: '<path d="M7 4h7l3 3v13H7Z"></path><path d="M14 4v4h4"></path><path d="M9.5 11h5"></path><path d="M9.5 14h5"></path><path d="M9.5 17h3"></path>',
  education: '<path d="m3.5 8.5 8.5-4 8.5 4-8.5 4Z"></path><path d="M6.5 10.25V15c1.8 1.6 3.65 2.4 5.5 2.4s3.7-.8 5.5-2.4v-4.75"></path><path d="M20.5 8.5v6"></path>',
  languages: '<circle cx="12" cy="12" r="8.5"></circle><path d="M3.75 12h16.5"></path><path d="M12 3.5c2.15 2.3 3.2 5.15 3.2 8.5s-1.05 6.2-3.2 8.5"></path><path d="M12 3.5C9.85 5.8 8.8 8.65 8.8 12s1.05 6.2 3.2 8.5"></path>',
  interests: '<path d="M12 20s-7-4.4-7-10a3.8 3.8 0 0 1 6.8-2.35A3.8 3.8 0 0 1 18.6 10c0 5.6-6.6 10-6.6 10Z"></path>',
  contact: '<rect x="4" y="6" width="16" height="12" rx="2"></rect><path d="m5 8 7 5 7-5"></path>'
};

function navIcon(id: string) {
  return navIcons[id] ?? navIcons.bio;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile.name} | CV</title>
  </head>
  <body>
    <header class="topbar">
      <nav class="topbar__inner" aria-label="Profile sections">
        <div class="topbar__links">
          {
            navSections.map((section) => (
              <a class="topbar__link" href={sectionHref(section)}>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={navIcon(section.id)} />
                <span>{section.title}</span>
              </a>
            ))
          }
          {contactAvailable && (
            <a class="topbar__link" href="#contact">
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={navIcon("contact")} />
              <span>Contact</span>
            </a>
          )}
        </div>
      </nav>
    </header>

    <main id="top" class="page">
      <section class="profile-card" aria-labelledby="profile-title">
        <div class="profile-card__banner">
          {profile.assets?.banner?.publicPath && (
            <img
              src={profile.assets.banner.publicPath}
              alt={profile.assets.banner.alt}
              style={`object-position: ${profile.assets.banner.position ?? "center"}`}
            />
          )}
        </div>
        <div class="profile-card__body">
          <div class="profile-card__photo">
            {profile.assets?.photo?.publicPath ? (
              <img
                src={profile.assets.photo.publicPath}
                alt={profile.assets.photo.alt}
                style={`object-position: ${profile.assets.photo.position ?? "center"}`}
              />
            ) : (
              <span>{profile.name.split(" ").map((part) => part[0]).join("")}</span>
            )}
          </div>
          <div class="profile-card__content">
            <h1 id="profile-title">{profile.name}</h1>
            <p class="profile-card__headline">{profile.title}</p>
            {profile.location && <p class="muted">{profile.location}</p>}
            <div class="actions">
              <a class="button button--primary" href={pdfHref}>
                <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3v11"></path>
                  <path d="m7.5 10.5 4.5 4.5 4.5-4.5"></path>
                  <path d="M5 18v2h14v-2"></path>
                </svg>
                <span>Download CV</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      {navSections.map((section) => (
        <section class="section-card" id={section.id} aria-labelledby={`${section.id}-title`}>
          <h2 id={`${section.id}-title`}>{section.title}</h2>

          {renderBlocks(section.blocks).map((block) =>
            block.kind === "detail" ? (
              <details class="detail" open={block.open}>
                <summary>{block.label ?? (block.open ? "Details" : "Show details")}</summary>
                <div set:html={block.html} />
              </details>
            ) : (
              <div class="content" set:html={block.html} />
            )
          )}

          {section.entries.map((entry) => (
            <article class="entry">
              {entry.icon?.publicPath && <img class="entry__icon" src={entry.icon.publicPath} alt={entry.icon.alt} />}
              <div class="entry__header">
                <h3>{entry.title}</h3>
                {primaryRole(entry) && <p class="entry__role">{primaryRole(entry)}</p>}
                <p class="entry__meta">
                  {[entry.fields.Period, entry.fields.Location, entry.fields.Date, entry.fields.Venue]
                    .filter(Boolean)
                    .join(" / ")}
                </p>
              </div>
              {entry.fields.Level && (
                <div class="skill-meter" aria-label={`Skill level ${entry.fields.Level} out of 100`}>
                  <span style={`width: ${entry.fields.Level}%`}></span>
                </div>
              )}
              {renderBlocks(entry.blocks).map((block) =>
                block.kind === "detail" ? (
                  <details class="detail" open={block.open}>
                    <summary>{block.label ?? (block.open ? "Details" : "Show details")}</summary>
                    <div set:html={block.html} />
                  </details>
                ) : (
                  <div class="content" set:html={block.html} />
                )
              )}
            </article>
          ))}
        </section>
      ))}

      {contactAvailable && (
        <section class="section-card contact" id="contact" aria-labelledby="contact-title">
          <h2 id="contact-title">Contact</h2>
          <div class="contact__links">
            {profile.email && (
              <a class="contact__item" href={`mailto:${profile.email}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect>
                  <path d="m4.5 7 7.5 5.25L19.5 7"></path>
                </svg>
                <span>{profile.email}</span>
              </a>
            )}
            {profile.phone && (
              <a class="contact__item" href={`tel:${profile.phone.replace(/\s/g, "")}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7.25 3.75h2.1l1.15 4.15-1.7 1.7a14.25 14.25 0 0 0 5.6 5.6l1.7-1.7 4.15 1.15v2.1c0 1.1-.9 2-2 2C10.1 18.75 5.25 13.9 5.25 5.75c0-1.1.9-2 2-2Z"></path>
                </svg>
                <span>{profile.phone}</span>
              </a>
            )}
            {profile.links.linkedin && (
              <a class="contact__item" href={profile.links.linkedin}>
                <img class="contact__icon" src={linkedinMarkUrl.src ?? linkedinMarkUrl} alt="" />
                <span>LinkedIn</span>
              </a>
            )}
            {profile.links.github && (
              <a class="contact__item" href={profile.links.github}>
                <img class="contact__icon" src={githubMarkUrl.src ?? githubMarkUrl} alt="" />
                <span>GitHub</span>
              </a>
            )}
          </div>
        </section>
      )}
    </main>
  </body>
</html>
